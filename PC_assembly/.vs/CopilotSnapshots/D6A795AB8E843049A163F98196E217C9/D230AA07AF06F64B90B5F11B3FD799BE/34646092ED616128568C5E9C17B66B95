<Page x:Class="PC_assembly.Pages.ComponentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PC_assembly.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ComponentsPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="Название"/>
            <Label Content="Тип"/>
            <Label Content="Цена"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBox Margin="5" Text="{Binding Name}"/>
            <TextBox Margin="5" Text="{Binding Type}"/>
            <TextBox Margin="5" Text="{Binding Price}"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Button Content="Сохранить" Click="SaveButton_Click"/>
            <Button Content="Назад" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
