<Page x:Class="PC_assembly.Pages.BuildFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PC_assembly.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BuildFormPage"
      Background="#F3F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сборка" FontSize="20" FontWeight="Bold" Margin="5,0,0,10"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#D0D7E2"
                BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="ID" Margin="5" Padding="4"/>
                    <Label Content="Название" Margin="5" Padding="4"/>
                    <Label Content="Назначение" Margin="5" Padding="4"/>
                    <Label Content="Владелец" Margin="5" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBox x:Name="IdTextBox" Margin="5" Padding="4" Text="{Binding CurrentBuild.Id}"/>
                    <TextBox Margin="5" Padding="4" Text="{Binding CurrentBuild.Name}"/>
                    <TextBox Margin="5" Padding="4" Text="{Binding CurrentBuild.Purpose}"/>
                    <TextBox Margin="5" Padding="4" Text="{Binding CurrentBuild.Owner}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Компоненты" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="5,0,20,0"/>
            <Button Click="AddComponent_Click" Margin="5" Padding="12,6" MinWidth="90"
                    Background="#3F6FB5" Foreground="White" BorderThickness="0">Добавить</Button>
            <Button Click="EditComponent_Click" Margin="5" Padding="12,6" MinWidth="90"
                    Background="#3F6FB5" Foreground="White" BorderThickness="0">Изменить</Button>
            <Button Click="DeleteComponent_Click" Margin="5" Padding="12,6" MinWidth="90"
                    Background="#C0392B" Foreground="White" BorderThickness="0">Удалить</Button>
        </StackPanel>

        <ListView Grid.Row="3"
                  Margin="5"
                  MinHeight="150"
                  Background="White"
                  BorderBrush="#D0D7E2"
                  BorderThickness="1"
                  ItemsSource="{Binding CurrentBuild.Components}"
                  SelectedItem="{Binding SelectedComponent}"
                  MouseDoubleClick="EditComponent_Click">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" Width="250"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Тип" Width="200"
                                    DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Цена" Width="120"
                                    DisplayMemberBinding="{Binding Price}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Background="AntiqueWhite">
            <Label VerticalAlignment="Center">Общая стоимость сборки:</Label>
            <Label VerticalAlignment="Center" FontWeight="Bold"
                   Content="{Binding CurrentBuild.BuildTotal}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" Margin="5" Padding="12,6" MinWidth="90"
                    Background="#3F6FB5" Foreground="White" BorderThickness="0"/>
            <Button Content="Назад" Click="BackButton_Click" Margin="5" Padding="12,6" MinWidth="90"
                    Background="Gray" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Page>