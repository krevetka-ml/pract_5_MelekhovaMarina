<Page x:Class="PC_assembly.Pages.ListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PC_assembly.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="ListPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
            <TextBlock Text="Компьютерные сборки"
                       FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="5,0,25,0"/>
            <Button Click="AddClick" Margin="5" Padding="12" Width="90"
                    Background="#3F6FB5" Foreground="White" >Добавить</Button>
            <Button Click="EditClick" Margin="5" Padding="12" Width="90"
                    Background="#3F6FB5" Foreground="White" >Изменить</Button>
            <Button Content="Сохранить в JSON" Click="SaveJsonClick" Margin="5" 
                    Padding="5" Background="#3F6FB5" Foreground="White"/>
            <Button Click="DeleteClick" Margin="5" Padding="12" Width="90"
                    Background="#C0392B" Foreground="White" >Удалить</Button>
        </StackPanel>

        <ListView Grid.Row="1"
                  Margin="15,10,15,10"
                  BorderThickness="0"
                  ItemsSource="{Binding Builds}"
                  SelectedItem="{Binding SelectedBuild}"
                  MouseDoubleClick="EditClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" Padding="12">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="№"/>
                                <Run Text="{Binding Id, Mode=OneWay}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Назначение: " Foreground="Gray"/>
                                <TextBlock Text="{Binding Purpose}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Владелец: " Foreground="Gray"/>
                                <TextBlock Text="{Binding Owner}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Компонентов: " Foreground="Gray"/>
                                <TextBlock Text="{Binding Components.Count}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Общая стоимость сборки: " Foreground="Gray"/>
                                <TextBlock Text="{Binding BuildTotal}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    Background="AntiqueWhite">
            <Label VerticalAlignment="Center">Всего в списке:</Label>
            <Label VerticalAlignment="Center" FontWeight="Bold"
                   Content="{Binding Builds.Count}"/>
        </StackPanel>
    </Grid>
</Page>