<Page x:Class="PC_assembly.Pages.ComponentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PC_assembly.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="ComponentPage">
    <StackPanel Margin="15">
        <TextBlock Text="Компонент" FontSize="20" FontWeight="Bold" Margin="5,0,0,10"/>

        <Border Background="White" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="Название" Margin="5" Padding="4"/>
                    <Label Content="Тип" Margin="5" Padding="4"/>
                    <Label Content="Цена" Margin="5" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBox Margin="5" Padding="4" Text="{Binding Name}"/>
                    <TextBox Margin="5" Padding="4" Text="{Binding Type}"/>
                    <TextBox x:Name="PriceBox" Margin="5" Padding="4" Text="{Binding Price}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveClick" Margin="5" Padding="12" Width="90"
                    Background="#3F6FB5" Foreground="White"/>
            <Button Content="Назад" Click="BackClick" Margin="5" Padding="12" Width="90"
                    Background="Gray" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Page>