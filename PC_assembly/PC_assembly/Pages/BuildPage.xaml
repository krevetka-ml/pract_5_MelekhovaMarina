<Page x:Class="PC_assembly.Pages.BuildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PC_assembly.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="BuildPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сборка" FontSize="20" FontWeight="Bold" Margin="5,0,0,10"/>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="ID" Margin="5" Padding="4"/>
                    <Label Content="Название" Margin="5" Padding="4"/>
                    <Label Content="Назначение" Margin="5" Padding="4"/>
                    <Label Content="Владелец" Margin="5" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBox x:Name="IdBox" Margin="5" Padding="4" IsReadOnly="True" Text="{Binding Current.Id}"/>
                    <TextBox Margin="5" Padding="4" Text="{Binding Current.Name}"/>
                    <TextBox Margin="5" Padding="4" Text="{Binding Current.Purpose}"/>
                    <TextBox Margin="5" Padding="4" Text="{Binding Current.Owner}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Компоненты" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="5,0,20,0"/>
            <Button Click="AddClick" Margin="5" Padding="12" Width="90"
                    Background="#3F6FB5" Foreground="White" >Добавить</Button>
            <Button Click="EditClick" Margin="5" Padding="12" Width="90"
                    Background="#3F6FB5" Foreground="White" >Изменить</Button>
            <Button Click="DeleteClick" Margin="5" Padding="12" Width="90"
                    Background="#C0392B" Foreground="White" >Удалить</Button>
        </StackPanel>

        <ListView Grid.Row="3"
                  Margin="5"
                  Background="White"
                  ItemsSource="{Binding Current.Components}"
                  SelectedItem="{Binding SelectedComponent}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" Width="250"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Тип" Width="200"
                                    DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Цена" Width="120"
                                    DisplayMemberBinding="{Binding Price}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Background="AntiqueWhite">
            <Label VerticalAlignment="Center">Общая стоимость сборки:</Label>
            <Label VerticalAlignment="Center" FontWeight="Bold"
                   Content="{Binding Current.BuildTotal}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveClick" Margin="5" Padding="12" Width="90"
                    Background="#3F6FB5" Foreground="White"/>
            <Button Content="Назад" Click="BackClick" Margin="5" Padding="12" Width="90"
                    Background="Gray" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>